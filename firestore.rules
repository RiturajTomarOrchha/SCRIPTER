rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'riturajtomarorchha@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'phone', 'bio',
          'creatorType', 'industry', 'category', 'organizationName',
          'contentGoals', 'targetAudience', 'preferredLanguage', 'preferredTone',
          'location', 'website', 'onboardingCompleted', 'onboardingStep',
          'socialLinks', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.role in ['user', 'admin', 'master-admin'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('creatorType' in data) || (data.creatorType is string && data.creatorType.size() <= 64)) &&
        (!('industry' in data) || (data.industry is string && data.industry.size() <= 64)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('organizationName' in data) || (data.organizationName is string && data.organizationName.size() <= 128)) &&
        (!('contentGoals' in data) || (data.contentGoals is string && data.contentGoals.size() <= 256)) &&
        (!('targetAudience' in data) || (data.targetAudience is string && data.targetAudience.size() <= 128)) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 32)) &&
        (!('preferredTone' in data) || (data.preferredTone is string && data.preferredTone.size() <= 64)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 128)) &&
        (!('website' in data) || (data.website is string && data.website.size() <= 256)) &&
        (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
        (!('onboardingStep' in data) || (data.onboardingStep is int && data.onboardingStep >= 0 && data.onboardingStep <= 10)) &&
        (!('socialLinks' in data) || data.socialLinks is map) &&
        data.uid == request.auth.uid;
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        (incoming().role == 'user' || isAdmin());

      allow update: if isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        (
          isAdmin() ||
          (
            !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'email', 'createdAt']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'phone', 'bio',
              'creatorType', 'industry', 'category', 'organizationName',
              'contentGoals', 'targetAudience', 'preferredLanguage', 'preferredTone',
              'location', 'website', 'onboardingCompleted', 'onboardingStep',
              'socialLinks', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admin Registry Collection (RBAC Source of Truth)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get, list: if isValidId(projectId) &&
        isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isValidId(projectId) &&
        isSignedIn() &&
        incoming().userId == request.auth.uid;

      allow update, delete: if isValidId(projectId) &&
        isSignedIn() &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // Business Profiles Collection
    match /businessProfiles/{profileId} {
      allow get, list: if isValidId(profileId) &&
        isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isValidId(profileId) &&
        isSignedIn() &&
        incoming().userId == request.auth.uid;

      allow update, delete: if isValidId(profileId) &&
        isSignedIn() &&
        (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
